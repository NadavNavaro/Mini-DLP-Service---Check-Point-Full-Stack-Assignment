            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Explanation is consistent with scan result\", () => { const d = pm.response.json().inspection_details.rules[0]; pm.expect(d.threshold).to.eql(3); pm.expect(d.match_count).to.eql(3); pm.expect(d.matched).to.eql(true); pm.expect(d.matched_keywords).to.deep.eql([{keyword:\"password\",match_count:1},{keyword:\"secret\",match_count:2}]); });"
            ]
          }
        }
      ]
    },
