{
  "info": {
    "name": "Mini DLP — full lifecycle",
    "description": "Run in order against the service. The demo rule contains eight configurable keywords. Each repeated whole-word occurrence counts separately; matching ignores case. Generated IDs are captured automatically. Tests cover CRUD, thresholds, multi-rule OR logic, whole-word negatives and invalid requests. A successful run removes its own demo resources. The optional environment overrides baseUrl (default http://localhost:8080). Optional include_details examples explain matched keywords and below-threshold rules; default responses retain the assignment format.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "dtId",
      "value": ""
    },
    {
      "key": "dsId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/actuator/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Healthy\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Create Data Type",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/datatypes",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sensitive Keywords\",\n  \"description\": \"Demo sensitive terms; repeated occurrences count separately\",\n  \"type\": \"keywords\",\n  \"content\": [\n    \"password\",\n    \"secret\",\n    \"confidential\",\n    \"token\",\n    \"credential\",\n    \"apikey\",\n    \"privatekey\",\n    \"classified\"\n  ],\n  \"threshold\": 3\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"dtId\", pm.response.json().id);",
              "pm.test(\"UUID generated\", () => pm.expect(pm.response.json().id).to.match(/^[0-9a-f-]{36}$/));"
            ]
          }
        }
      ]
    },
