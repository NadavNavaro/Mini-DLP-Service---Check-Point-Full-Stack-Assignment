              "pm.test(\"Matched at threshold\", () => { pm.expect(result.status).to.eql(\"match\"); pm.expect(result.detected_objects).to.have.lengthOf(1); pm.expect(result.detected_objects[0].match_count).to.eql(3); });"
            ]
